NODE_ENV=development # development | production
PORT=3000

# Preferred for hosted PostgreSQL providers like Neon.
# For Neon, use sslmode=verify-full in the connection string.
DATABASE_URL=
DB_SSL=true

# Optional local PostgreSQL fallback when DATABASE_URL is not set.
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=
DB_PORT=
DB_LOGGING=false

# Auth — REQUIRED. Use a long random string (e.g. `openssl rand -hex 64`).
JWT_SECRET=
# Short-lived access token lifetime. The refresh token keeps sessions alive.
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token lifetime (drives the DB-stored expiry).
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth / OpenID Connect — required for "Continue with Google".
# Comma-separated list of every accepted OAuth client ID (audience): the
# mobile app's iOS, Android and Web client IDs from Google Cloud Console.
# Verified ID tokens must carry one of these as their `aud` claim.
GOOGLE_CLIENT_IDS=

# Email (SMTP) — used to send the email-verification code on signup.
# Leave SMTP_HOST blank in local dev: the server then logs the code to the
# console instead of sending mail, so you can still complete the flow.
# Works with any SMTP provider (Gmail app password, SendGrid, Mailgun,
# Mailtrap, etc.). Use port 465 with SMTP_SECURE=true, or 587 with STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=GroupCoin <no-reply@groupcoin.app>

# Email verification code settings (sensible defaults; override if needed).
EMAIL_VERIFICATION_CODE_LENGTH=6
EMAIL_VERIFICATION_TTL=15m
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
